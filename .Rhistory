df <- read_excel("C:/Users/matut/OneDrive/Desktop/tute/Facultad/Estadistica/base_usuario_encoprac.xlsx")
ggplot(df, aes(x = AL_03)) +
geom_histogram(binwidth = 1, fill = "#69b3a2", color = "white") +
labs(title = "Distribución de la Edad de Inicio de Consumo",
x = "Edad de Inicio (AL_03)",
y = "Frecuencia") +
theme_minimal()
